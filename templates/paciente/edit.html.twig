{% extends 'base.html.twig' %} {% block title %}Editar Paciente{% endblock %} {%
block body %}
<div class="container my-5">
  <h1 class="text-center mb-4">Editar Paciente</h1>

  {{ form_start(form, {'attr': {'class': 'p-4 border rounded shadow-sm bg-light'
  }}) }}
  <div class="row">
    <div class="col-md-6">
      <h2 class="mb-3">Datos del Paciente</h2>
      {{ form_row(form.nombre) }}
      {{ form_row(form.apellido) }}
      {{ form_row(form.fechaNacimiento) }}
      {{ form_row(form.dni) }}
      {{ form_row(form.numeroExpediente) }}
      {{ form_row(form.diagnosticoPrincipal) }}
      {{ form_row(form.observaciones) }}
    </div>
    <div class="col-md-6">
      <h2 class="mb-3">Información de Contacto</h2>
      {{ form_row(form.direccion) }}
      {{ form_row(form.telefono) }}
      {{ form_row(form.email) }}

      <h2 class="mt-4 mb-3">Información Familiar (Opcional)</h2>
      {{ form_row(form.mama) }}
      {{ form_row(form.papa) }}
      {{ form_row(form.encargado) }}
    </div>
  </div>

  <div class="d-grid gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-lg">
      Actualizar Paciente
    </button>
    <a
      href="{{ path('app_paciente_show', { id: paciente.id }) }}"
      class="btn btn-info btn-lg"
      >Volver al detalle</a
    >
    <a href="{{ path('app_paciente_index') }}" class="btn btn-secondary btn-lg"
      >Volver a la lista</a
    >
  </div>
  {{ form_end(form) }}
</div>
{% endblock %}
