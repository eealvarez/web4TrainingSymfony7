{# templates/paciente/edit.html.twig #} {% extends 'base.html.twig' %} {% block
title %}Editar Paciente{% endblock %} {% block body %}
<div class="container my-5">
  <h1 class="text-center mb-4">Editar Paciente</h1>

  {{ form_start(form, {'attr': {'class': 'p-4 border rounded shadow-sm bg-light', 'id': 'paciente-form'




  }}) }} {{ form_widget(form.id) }}
  <div class="row">
    <div class="col-md-6">
      <h2 class="mb-3">Datos del Paciente</h2>
      {{ form_row(form.nombre) }}
      {{ form_row(form.apellido) }}
      {{ form_row(form.fechaNacimiento) }}
      {{ form_row(form.dni) }}
      {{ form_row(form.numeroExpediente) }}
      {{ form_row(form.diagnosticoPrincipal) }}
      {{ form_row(form.observaciones) }}
    </div>
    <div class="col-md-6">
      <h2 class="mb-3">Información de Contacto</h2>
      {{ form_row(form.direccion) }}
      {{ form_row(form.telefono) }}
      {{ form_row(form.email) }}

      <h2 class="mt-4 mb-3">Información Familiar</h2>
      {{ form_row(form.familiar_tipo) }}

      <div id="familiar-fields-container">
        {# Incluye el fragmento para que se rendericen los campos correctos al
        cargar la página #} {# {% include 'paciente/_familiar_fields.html.twig'
        with {'form': form} %} #}
      </div>
    </div>
  </div>

  <div class="d-grid gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-lg">
      Actualizar Paciente
    </button>
    <a
      href="{{ path('app_paciente_show', { id: paciente.id }) }}"
      class="btn btn-info btn-lg"
      >Volver al detalle</a
    >
    <a href="{{ path('app_paciente_index') }}" class="btn btn-secondary btn-lg"
      >Volver a la lista</a
    >
  </div>
  <div id="familiar-fields-container">
    {# This will be filled by JavaScript. Ensure the previous include is
    removed. #}
  </div>

  <button class="btn btn-primary">
    {{ button_label|default('Actualizar') }}
  </button>
  {{ form_end(form) }}
</div>
{% endblock %} {% block javascripts %}
{{ parent() }}
<script>
  document.addEventListener('DOMContentLoaded', function() {
      const familiarTypeSelect = document.getElementById('{{ form.familiar_tipo.vars.id }}');
      const form = document.getElementById('paciente-form');
      const familiarContainer = document.getElementById('familiar-fields-container');

      // **IMPORTANTE**: Ocultar todos los grupos de familiar al cargar la página inicialmente
      // Esto previene que se muestren todos los campos vacíos antes de que el JS tome control.
      document.querySelectorAll('.familiar-group').forEach(group => {
          group.style.display = 'none';
      });


      const refreshFamiliarFields = async () => {
          const selectedType = familiarTypeSelect.value;
          const url = '{{ path('app_paciente_familiar_fields') }}';
          const method = 'POST';

          const formData = new FormData(form);

          // Asegúrate de que el ID del paciente se envía si estás en el modo edición.
          // Esto es crucial para que el controlador pueda rehidratar correctamente el paciente
          // y sus relaciones existentes para mostrar los 'details' forms.
          {% if paciente is defined and paciente.id is not null %}
              formData.append('paciente[id]', '{{ paciente.id }}');
          {% endif %}

          // Envia el valor actual de familiar_tipo para que el controlador sepa qué añadir
          formData.set(familiarTypeSelect.name, selectedType);


          try {
              const response = await fetch(url, {
                  method: method,
                  body: formData,
                  headers: {
                      'X-Requested-With': 'XMLHttpRequest'
                  }
              });

              if (!response.ok) {
                  throw new Error(`HTTP error! status: ${response.status}`);
              }

              const data = await response.text();
              familiarContainer.innerHTML = data; // Reemplaza el contenido del contenedor

              // --- LÓGICA DE VISIBILIDAD DE LOS CAMPOS (después de que el HTML es inyectado) ---
              // Ocultar todos los grupos de familiar (nuevamente, en caso de que el AJAX traiga más)
              document.querySelectorAll('.familiar-group').forEach(group => {
                  group.style.display = 'none';
              });

              // Mostrar solo el grupo correspondiente al tipo seleccionado
              const selectedGroup = document.querySelector(`.familiar-group[data-familiar-type="${selectedType}"]`);
              if (selectedGroup) {
                  selectedGroup.style.display = 'block';
              }
              // --- FIN LÓGICA DE VISIBILIDAD ---

              // Si se seleccionó una opción de "existente" y hay un campo de selección,
              // podemos añadir un listener para actualizar los detalles si la selección cambia.
              // (Esto es un paso AVANZADO para una funcionalidad completa de "existente")
              // Por ahora, si `mama_details` se carga, ya mostrará la data asociada.
              // Si el usuario cambia el selector, para ver los detalles del *nuevo* seleccionado,
              // necesitarías hacer otra llamada AJAX aquí o tener un objeto JS con todos los detalles.

              // Ejemplo para el futuro si quieres actualizar los detalles de 'mama_details'
              // cuando se cambia 'mama_select':
              /*
              const mamaSelect = familiarContainer.querySelector('[name*="mama_select"]');
              if (mamaSelect) {
                  mamaSelect.addEventListener('change', async function() {
                      const selectedMamaId = this.value;
                      if (selectedMamaId) {
                          // Aquí harías otra petición AJAX para obtener los detalles de la mamá
                          // con `selectedMamaId` y actualizar el div de `mama_details`
                          console.log('Mamá seleccionada:', selectedMamaId);
                          // Esto implicaría una nueva ruta/controlador para obtener detalles de un familiar por ID
                      }
                  });
              }
              */

          } catch (error) {
              console.error('Error al actualizar los campos del familiar:', error);
          }
      };

      familiarTypeSelect.addEventListener('change', refreshFamiliarFields);

      // Ejecutar al cargar la página para establecer el estado inicial correcto
      // Esto asegura que solo el grupo correcto se muestre desde el principio.
      refreshFamiliarFields();
  });
</script>
{% endblock %}
